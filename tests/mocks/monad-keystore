#!/usr/bin/env bash
# Mock monad-keystore for tests.
#
# import:  creates the keystore file at --keystore-path, embedding the IKM so
#          recover can round-trip it. Validates IKM is 64 hex chars.
# recover: prints public key + IKM lines in the same shape as the real tool.
set -euo pipefail

cmd="${1:-}"; shift || true

IKM="" KEYSTORE_PATH="" KEY_TYPE="" PASSWORD=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --ikm)           shift; IKM="$1" ;;
    --keystore-path) shift; KEYSTORE_PATH="$1" ;;
    --key-type)      shift; KEY_TYPE="$1" ;;
    --password)      shift; PASSWORD="$1" ;;
  esac
  shift
done

log() { echo "$(basename "$0") $cmd type=$KEY_TYPE path=$KEYSTORE_PATH" >> "${MOCK_LOG:-/dev/null}"; }

case "$cmd" in
  import)
    [[ "$IKM" =~ ^[0-9a-fA-F]{64}$ ]] || { echo "invalid IKM" >&2; exit 1; }
    [[ -n "$KEYSTORE_PATH" ]] || { echo "missing --keystore-path" >&2; exit 1; }
    [[ -n "$PASSWORD" ]] || { echo "missing --password" >&2; exit 1; }
    printf 'MOCK-KEYSTORE ikm=%s pw=%s\n' "$IKM" "$PASSWORD" > "$KEYSTORE_PATH"
    log
    ;;
  recover)
    [[ -f "$KEYSTORE_PATH" ]] || { echo "keystore not found: $KEYSTORE_PATH" >&2; exit 1; }
    stored_ikm="$(sed -n 's/^MOCK-KEYSTORE ikm=\([0-9a-fA-F]*\) .*/\1/p' "$KEYSTORE_PATH")"
    stored_pw="$(sed -n 's/.* pw=\(.*\)$/\1/p' "$KEYSTORE_PATH")"
    [[ "$stored_pw" == "$PASSWORD" ]] || { echo "ChecksumError: password mismatch" >&2; exit 1; }
    if [[ "$KEY_TYPE" == "secp" ]]; then
      echo "Secp public key: 0xSECP${stored_ikm:0:40}"
    else
      echo "BLS public key: 0xBLS${stored_ikm:0:40}"
    fi
    echo "Keystore secret: ${stored_ikm}"
    log
    ;;
  *)
    echo "mock monad-keystore: unknown command '$cmd'" >&2
    exit 1
    ;;
esac
