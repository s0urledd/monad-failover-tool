#!/usr/bin/env bash
# Mock monad-sign-name-record.
#
# Default output mirrors the CURRENT upstream shape documented for monad
# 0.16.x, which splits the address across fields:
#     self_ip = "1.2.3.4"
#     self_tcp_port = 8000
#     self_udp_port = 8000
# node.toml still wants one combined self_address, so the tool has to join
# self_ip and self_tcp_port itself.
#
# MOCK_SIGNER_LEGACY=1 emits the older combined `self_address = "IP:PORT"`
# form instead, so both shapes stay covered.
#
# The removed --address flag is rejected exactly like the real binary rejects
# an unknown argument. MOCK_SEQ_OFFSET simulates version drift for the guard
# tests. --node-config is a test failure by definition: passing it makes the
# real tool ignore the seq argument and sign the stale config value.
set -euo pipefail

IP="" TCP_PORT="" UDP_PORT="" SEQ=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --address)
      echo "error: unexpected argument '--address' (replaced by --ip/--tcp-port/--udp-port)" >&2
      exit 1 ;;
    --ip)                     shift; IP="$1" ;;
    --tcp-port)               shift; TCP_PORT="$1" ;;
    --udp-port)               shift; UDP_PORT="$1" ;;
    --self-record-seq-num)    shift; SEQ="$1" ;;
    --keystore-path)          shift ;;
    --password)               shift ;;
    --authenticated-udp-port) shift ;;
    --node-config)
      echo "mock monad-sign-name-record: --node-config must not be passed (it overrides the seq argument)" >&2
      exit 1 ;;
  esac
  shift
done

[[ -n "$IP" && -n "$TCP_PORT" && -n "$SEQ" ]] || { echo "missing args" >&2; exit 1; }
sig="$(printf 'ab%.0s' $(seq 1 65))"
out_seq=$(( SEQ + ${MOCK_SEQ_OFFSET:-0} ))

if [[ -n "${MOCK_SIGNER_LEGACY:-}" ]]; then
  echo "self_address = \"$IP:$TCP_PORT\""
else
  echo "self_ip = \"$IP\""
  echo "self_tcp_port = $TCP_PORT"
  echo "self_udp_port = ${UDP_PORT:-$TCP_PORT}"
fi
echo "self_record_seq_num = $out_seq"
echo "self_name_record_sig = \"$sig\""
