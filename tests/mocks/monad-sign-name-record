#!/usr/bin/env bash
# Mock monad-sign-name-record, mirroring the CURRENT upstream CLI: the old
# --address ip:port flag was replaced by separate --ip / --tcp-port /
# --udp-port flags. --help advertises the new flags so the script's CLI
# detection picks them, and --address is rejected exactly like the real
# binary rejects an unknown argument.
#
# MOCK_LEGACY_SIGNER=1 flips the mock to the OLD CLI: help does not mention
# --tcp-port, --address is accepted, --ip is rejected. Lets tests cover the
# detection on both sides.
#
# Called WITHOUT --node-config (like the official install guide), the real
# tool signs exactly the seq passed via --self-record-seq-num. MOCK_SEQ_OFFSET
# simulates version drift (e.g. +1 or -1) for the guard tests. A --node-config
# argument is a test failure by definition: passing it makes the real tool
# ignore the seq argument and sign the stale config value.
set -euo pipefail

if [[ "${1:-}" == "--help" ]]; then
  if [[ -n "${MOCK_LEGACY_SIGNER:-}" ]]; then
    echo "Usage: monad-sign-name-record --address <ip:port> --authenticated-udp-port <port> ..."
  else
    echo "Usage: monad-sign-name-record --ip <ip> --tcp-port <port> --udp-port <port> --authenticated-udp-port <port> ..."
  fi
  exit 0
fi

IP="" TCP_PORT="" ADDRESS="" SEQ=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --address)
      if [[ -z "${MOCK_LEGACY_SIGNER:-}" ]]; then
        echo "error: unexpected argument '--address' (replaced by --ip/--tcp-port/--udp-port)" >&2
        exit 1
      fi
      shift; ADDRESS="$1" ;;
    --ip)
      if [[ -n "${MOCK_LEGACY_SIGNER:-}" ]]; then
        echo "error: unexpected argument '--ip'" >&2
        exit 1
      fi
      shift; IP="$1" ;;
    --tcp-port)               shift; TCP_PORT="$1" ;;
    --udp-port)               shift ;;
    --self-record-seq-num)    shift; SEQ="$1" ;;
    --keystore-path)          shift ;;
    --password)               shift ;;
    --authenticated-udp-port) shift ;;
    --node-config)
      echo "mock monad-sign-name-record: --node-config must not be passed (it overrides the seq argument)" >&2
      exit 1 ;;
  esac
  shift
done

if [[ -n "$IP" && -n "$TCP_PORT" ]]; then
  ADDRESS="$IP:$TCP_PORT"
fi
[[ -n "$ADDRESS" && -n "$SEQ" ]] || { echo "missing args" >&2; exit 1; }
sig="$(printf 'ab%.0s' $(seq 1 65))"
echo "self_address = \"$ADDRESS\""
echo "self_record_seq_num = $((SEQ + ${MOCK_SEQ_OFFSET:-0}))"
echo "self_name_record_sig = \"$sig\""
